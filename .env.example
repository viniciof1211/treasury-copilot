# Supabase Configuration (Frontend)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Edge Functions automatically have access to these:
# SUPABASE_URL (auto-populated in Edge Functions)
# SUPABASE_SERVICE_ROLE_KEY (auto-populated in Edge Functions)
# SUPABASE_DB_URL (auto-populated in Edge Functions)

# Microsoft Foundry Agent Configuration
# Required for AI chat functionality
FOUNDARY_AGENT_BASE_URL=https://your-foundry-endpoint.com
FOUNDARY_AGENT_API_KEY=your-foundry-api-key
FOUNDARY_AGENT_ID=your-agent-id

# Google Gemini Image Generation
# Required for AI-generated visualizations
GEMINI_API_KEY=your-gemini-api-key
GEMINI_IMAGE_MODEL=nano-banana-pro

# Databricks Configuration (Optional)
# Required for Databricks SQL data connector
DATABRICKS_ENDPOINT=https://your-databricks-instance.com
DATABRICKS_TOKEN=your-databricks-token
