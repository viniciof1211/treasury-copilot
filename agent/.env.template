# ══════════════════════════════════════════════════════════════════════════════
# Environment template for CDC containers (secrets injected via K8s)
# ══════════════════════════════════════════════════════════════════════════════

# PcGraf ERP (SQL Server) — injected from K8s Secret 'pcgraf-credentials'
PCGRAF_SQL_SERVER=
PCGRAF_SQL_USER=
PCGRAF_SQL_PASSWORD=
PCGRAF_SQL_DATABASE=

# Supabase — injected from K8s Secret 'supabase-credentials'
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Kafka — injected from K8s ConfigMap 'cdc-config'
KAFKA_BOOTSTRAP_SERVERS=
KAFKA_TOPIC_PREFIX=siawin0

# CDC Settings — injected from K8s ConfigMap 'cdc-config'
CDC_POLL_INTERVAL=300
CDC_BATCH_SIZE=1000
CDC_MAX_ROWS=50000
