# ══════════════════════════════════════════════════════════════════════════════
# CDC Consumer — subscribes to Kafka topics, writes to Supabase canonical TMS
# ══════════════════════════════════════════════════════════════════════════════
FROM python:3.12-slim

LABEL maintainer="treasury-copilot"
LABEL component="cdc-consumer"

WORKDIR /app

# System deps for pymssql (FreeTDS) — needed for field mapping reference
RUN apt-get update && apt-get install -y --no-install-recommends \
    freetds-dev gcc g++ && \
    rm -rf /var/lib/apt/lists/*

# Python deps
COPY agent/requirements-cdc.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy CDC code
COPY agent/cdc/ /app/cdc/
COPY agent/.env.template /app/.env

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Consumer runs continuously
ENTRYPOINT ["python", "-m", "cdc.consumer"]
CMD []
