# ══════════════════════════════════════════════════════════════════════════════
# CDC Producer — polls PcGraf SQL Server, publishes to Kafka + Supabase
# ══════════════════════════════════════════════════════════════════════════════
FROM python:3.12-slim

LABEL maintainer="treasury-copilot"
LABEL component="cdc-producer"

WORKDIR /app

# System deps for pymssql (FreeTDS)
RUN apt-get update && apt-get install -y --no-install-recommends \
    freetds-dev gcc g++ && \
    rm -rf /var/lib/apt/lists/*

# Python deps
COPY agent/requirements-cdc.txt requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Copy CDC code
COPY agent/cdc/ /app/cdc/
COPY agent/.env.template /app/.env

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app

# Default: run one poll cycle (K8s CronJob will schedule it)
# Override with --daemon for continuous mode
ENTRYPOINT ["python", "-m", "cdc.runner"]
CMD ["--no-kafka"]
